                        "dataset": "pharma_dwh",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT 'dim_date' AS table_name, COUNT(*) AS total_rows\r\nFROM mart.dim_date\r\n\r\nUNION ALL\r\nSELECT 'dim_medicine', COUNT(*) FROM mart.dim_medicine\r\n\r\nUNION ALL\r\nSELECT 'dim_hospital', COUNT(*) FROM mart.dim_hospital\r\n\r\nUNION ALL\r\nSELECT 'dim_pharmacy', COUNT(*) FROM mart.dim_pharmacy\r\n\r\nUNION ALL\r\nSELECT 'dim_location', COUNT(*) FROM mart.dim_location\r\n\r\nUNION ALL\r\nSELECT 'dim_warehouse', COUNT(*) FROM mart.dim_warehouse\r\n\r\nUNION ALL\r\nSELECT 'fact_sales', COUNT(*) FROM mart.fact_sales\r\n\r\nUNION ALL\r\nSELECT 'fact_demand', COUNT(*) FROM mart.fact_demand\r\n\r\nORDER BY table_name;",
