                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n    query_name,\r\n    ROUND(AVG(execution_time_ms), 2) AS avg_execution_time_ms\r\nFROM analytics.query_execution_log\r\nWHERE query_status = 'Success'\r\nGROUP BY query_name\r\nORDER BY avg_execution_time_ms DESC;",
